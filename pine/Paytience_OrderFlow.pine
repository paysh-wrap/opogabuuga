//@version=6
// Paytience Order Flow — ORIGINAL code for the Paytience app (D95, rebuilt D101 around the AR Model framework of the
// user's main teacher: ENVIRONMENT -> LOCATION -> PATH -> CONFIRMATION; docs/results/session18/order_flow/AR_MODEL_RULES.md).
// Not derived from any third-party script. Shared for PERSONAL USE ONLY. UNVERIFIED: no real order-flow backtest exists;
// the app trades it on PAPER accounts only and applies every gate itself (backend/app/engine/order_flow.py).
//
// Delta source: REAL TradingView footprint data (request.footprint, needs a TradingView plan with footprint access and
// CME real-time data) when "Use real footprint" is on and data exists for the bar; otherwise ESTIMATED from
// lower-timeframe up/down volume. Every alert says which one: delta_source = "real" | "est".
// If TradingView rejects request.footprint on your plan (compile error), replace the "footprint fp = ..." line with
// "footprint fp = na": the script then runs on estimated delta only (docs/DECISIONS.md D101).
//
// Setup: MNQ1! or MGC1! chart (D96), 1-minute; one alert per chart. Paste the webhook secret, create an alert:
// Condition "Paytience Order Flow" -> "Any alert() function call", "Once per bar close", Webhook URL = your Paytience
// URL (.../api/webhook/tradingview). The Paytience_Bridge heartbeat alert must stay on as well (feed + flat checks).
//
// Flow (closed bars only, no lookahead):
//  1 ENVIRONMENT  5m: ATR(12)/daily ATR(20), candle overlap, efficiency ratio -> EXPANSION | ROTATION | COMPRESSION
//  2 LOCATION     15m swing range fib depth 0.5/0.62/0.705/0.788/0.886/1.1 (a close beyond 0.886 since the swing =
//                 INVALID) + fixed-range volume profile of the swing (VAH/VAL) -> location_zone, fib, value_side
//  3 PATH         Asia range (18:00-03:00 ET, locked at 03:00) + daily ATR(20) zones L1/AVR-/AVR/AVR+/MAX -> path_zone
//  4 CONFIRMATION effort vs result at a local extreme: ABSORPTION (heavy opposite delta, close back in the bar's
//                 favourable half), DELTA_DIVERGENCE (delta flip after failed initiative, or exhaustion = low effort at a
//                 new extreme), STACKED_IMBALANCE (>= N stacked diagonal imbalances, 400% default) -> confirmation candle;
//                 then the ENTRY candle that pulls back into the confirmation candle (within N bars) sends the alert.
//  + D108 Casper 4h-course refinement fields (each gated by its own app switch): close_pos (entry close in its range),
//    cvd_slope (sum of delta over the last N bars), open_vs_value (RTH open vs PRIOR RTH value area 09:30-16:00 ET),
//    prior_va_width_atr (prior value-area width in daily ATR(20)) — docs/results/session18/order_flow/TEACHER_RULES_4H.md.
//  + D110 AMT+ fields (used only with the app's AMT+ button): prev_rth_vah/val/poc, eth_vwap, context (acceptance vs the
//    prior RTH value area at each session open: ACCEPT_ABOVE | ACCEPT_BELOW | BALANCE), ctx_session, key_level_type
//    (ETH_VWAP / PRIOR_VAH / PRIOR_VAL / PRIOR_POC / PRIOR_HIGH / PRIOR_LOW / LVN / DELTA_OUTLIER), target_level.
// The indicator SENDS every confirmed setup with its layer values; the app decides (skip codes are shown in the app).
// Stop = beyond the absorption zone (+ buffer). The app rebuilds stop/target itself and never trusts these prices.
indicator("Paytience Order Flow", overlay = true, max_labels_count = 200, max_bars_back = 1000)

secret    = input.string("", "Webhook secret")
useFp     = input.bool(false, "Use real footprint (request.footprint) — needs a plan with footprint + seconds timeframes (Premium/Ultimate); leave OFF otherwise")
ltf       = input.timeframe("1", "Fallback: lower timeframe for estimated delta (use 1 = minutes; seconds like 5S need a TradingView Plus plan)")
rowTicks  = input.int(4, "Footprint / profile row size (ticks)", minval = 1)
imbPct    = input.int(400, "Imbalance % (diagonal)", minval = 100)
stackN    = input.int(3, "Stacked imbalances needed", minval = 2)
liqLen    = input.int(20, "Local extreme lookback (bars)", minval = 2)
avgLen    = input.int(20, "Average length (volume / delta)", minval = 2)
absK      = input.float(1.5, "Effort: |delta| >= k x average |delta|", minval = 0.1)
exhK      = input.float(0.6, "Exhaustion: volume <= k x average volume", minval = 0.05)
erExp     = input.float(0.4, "Expansion: 5m efficiency ratio >=", minval = 0.05, maxval = 1)
waitBars  = input.int(3, "Entry candle within N bars of the confirmation", minval = 1, maxval = 15)
vaPct     = input.float(70.0, "Value area %", minval = 10, maxval = 100)
maxBack   = input.int(600, "Swing profile: max 1m bars back", minval = 50, maxval = 990)
bufTicks  = input.int(1, "Stop buffer beyond the absorption zone (ticks)", minval = 1)
cvdBars   = input.int(3, "Casper: CVD slope over N bars", minval = 1, maxval = 30)
accN      = input.int(30, "AMT+: acceptance read = first N 1m bars of a session", minval = 5, maxval = 120)
accPct    = input.float(70.0, "AMT+: acceptance = >= % of those closes above / below prior RTH value", minval = 50, maxval = 100)
lvlTicks  = input.int(8, "AMT+: key level within N ticks of the signal bar", minval = 1, maxval = 40)
lvnPct    = input.float(30.0, "AMT+: LVN = prior RTH row volume <= % of the POC row", minval = 5, maxval = 60)
outK      = input.float(3.0, "AMT+: delta outlier = |delta| >= k x average |delta|", minval = 1.5)
zoneOn    = input.bool(true, "D111 ATR zones: send ZONE alerts (iceberg PROXY, no MBO data)")
evVolK    = input.float(2.5, "Zone event: volume >= k x average volume (or heavy delta)", minval = 1.0)
useTick   = input.bool(false, "Zone: send NYSE TICK (program-day filter)")
tickSym   = input.symbol("USI:TICK", "Zone: TICK symbol")
showMarks = input.bool(true, "Show markers")

if timeframe.period != "1"
    runtime.error("Paytience Order Flow needs a 1-minute chart")
if syminfo.root != "MNQ" and syminfo.root != "MGC"
    runtime.error("Paytience Order Flow trades MNQ1! or MGC1! only (D96)")

bool isGold = syminfo.root == "MGC"
// In-sample calibration of the session-18 AR study (docs/results/session18/ar_model/ar.json, PICK period, ESTIMATED):
// environment thresholds and Asia-extension quantiles (20/35/50/70/90 %) in daily-ATR(20) units, per market.
float atrrQ30 = isGold ? 0.0372 : 0.0331
float atrrQ95 = isGold ? 0.1146 : 0.1216
float ovMed   = isGold ? 0.628 : 0.628
array<float> zUp = isGold ? array.from(0.123, 0.212, 0.281, 0.359, 0.531) : array.from(0.118, 0.204, 0.295, 0.474, 0.804)
array<float> zDn = isGold ? array.from(0.105, 0.179, 0.280, 0.456, 0.992) : array.from(0.107, 0.195, 0.312, 0.479, 1.064)
array<string> zNames = array.from("L1", "AVR-", "AVR", "AVR+", "MAX")

// ---------- delta: real footprint, else estimated from lower-timeframe bars ----------
footprint fp = useFp ? request.footprint(rowTicks, vaPct, imbPct) : na
array<float> lo_o = request.security_lower_tf(syminfo.tickerid, ltf, open)
array<float> lo_c = request.security_lower_tf(syminfo.tickerid, ltf, close)
array<float> lo_v = request.security_lower_tf(syminfo.tickerid, ltf, volume)

bool real = not na(fp)
float delta = 0.0
int stackBuy = 0
int stackSell = 0
float absTopL = na   // long: top of the row with the most aggressive selling in the lower half (absorbed sellers)
float absBotS = na   // short: bottom of the row with the most aggressive buying in the upper half (absorbed buyers)
if real
    delta := fp.delta()
    array<volume_row> rows = fp.rows()
    int runB = 0
    int runS = 0
    float bestSell = -1.0
    float bestBuy = -1.0
    int nr = array.size(rows)
    if nr > 0
        for i = 0 to nr - 1
            volume_row r = array.get(rows, i)
            runB := r.has_buy_imbalance() ? runB + 1 : 0
            runS := r.has_sell_imbalance() ? runS + 1 : 0
            stackBuy := math.max(stackBuy, runB)
            stackSell := math.max(stackSell, runS)
            if r.up_price() <= hl2 and r.sell_volume() > bestSell
                bestSell := r.sell_volume()
                absTopL := r.up_price()
            if r.down_price() >= hl2 and r.buy_volume() > bestBuy
                bestBuy := r.buy_volume()
                absBotS := r.down_price()
else
    float upV = 0.0
    float dnV = 0.0
    int runB = 0
    int runS = 0
    int n = array.size(lo_v)
    if n > 0
        for i = 0 to n - 1
            float o = array.get(lo_o, i)
            float c = array.get(lo_c, i)
            float v = array.get(lo_v, i)
            float u = c > o ? v : c < o ? 0.0 : v / 2
            float d = v - u
            upV += u
            dnV += d
            runB := u > 0 and u * 100 >= imbPct * math.max(d, 1e-10) ? runB + 1 : 0
            runS := d > 0 and d * 100 >= imbPct * math.max(u, 1e-10) ? runS + 1 : 0
            stackBuy := math.max(stackBuy, runB)
            stackSell := math.max(stackSell, runS)
    delta := upV - dnV
if na(absTopL)
    absTopL := math.min(open, close)   // estimated: the lower wick
if na(absBotS)
    absBotS := math.max(open, close)   // estimated: the upper wick
string dSrc = real ? "real" : "est"

// ---------- 1 ENVIRONMENT (5m, closed bars) ----------
f_env() =>
    float tr5 = ta.tr(true)
    float atr5 = ta.sma(tr5, 12)
    float er = math.abs(close - close[12]) / math.max(math.sum(math.abs(ta.change(close)), 12), syminfo.mintick)
    float ovl = math.max(math.min(high, high[1]) - math.max(low, low[1]), 0) / math.max(high - low, syminfo.mintick)
    float ov = ta.sma(ovl, 12)
    [atr5[1], er[1], ov[1]]
[atr5, er5, ov5] = request.security(syminfo.tickerid, "5", f_env(), lookahead = barmerge.lookahead_on)
float atrD = request.security(syminfo.tickerid, "D", ta.atr(20)[1], lookahead = barmerge.lookahead_on)
float atrr = na(atrD) or atrD <= 0 ? na : atr5 / atrD
bool comp = not na(atrr) and ((atrr < atrrQ30 and ov5 > ovMed) or atrr > atrrQ95)
string env = na(atrr) ? "" : comp ? "COMPRESSION" : er5 >= erExp ? "EXPANSION" : "ROTATION"

// ---------- 2 LOCATION (15m swing range + fixed-range profile) ----------
f_sw() =>
    float ph = ta.pivothigh(high, 2, 2)
    float pl = ta.pivotlow(low, 2, 2)
    float h = ta.valuewhen(not na(ph), ph, 0)
    float ht = ta.valuewhen(not na(ph), time[2], 0)
    float l = ta.valuewhen(not na(pl), pl, 0)
    float lt = ta.valuewhen(not na(pl), time[2], 0)
    [h[1], ht[1], l[1], lt[1]]
[swH, swHt, swL, swLt] = request.security(syminfo.tickerid, "15", f_sw(), lookahead = barmerge.lookahead_on)
float rng = swH - swL
bool swingOk = not na(rng) and not na(atrD) and rng >= 0.2 * atrD and rng <= 2.5 * atrD
int bias = not swingOk ? 0 : swLt < swHt ? 1 : -1   // impulse up -> long retracements; impulse down -> shorts

// extreme close since the swing's last pivot (for the "close beyond 0.886 = invalid" rule)
float extCl = na
if swingOk and barstate.isconfirmed
    float pivT = bias == 1 ? swHt : swLt
    float e = close
    for i = 0 to maxBack
        if time[i] < pivT
            break
        e := bias == 1 ? math.min(e, close[i]) : math.max(e, close[i])
    extCl := e
float depth = not swingOk ? na : bias == 1 ? (swH - close) / rng : (close - swL) / rng
float extDepth = na(extCl) ? na : bias == 1 ? (swH - extCl) / rng : (extCl - swL) / rng
f_zone(float d, float ed) =>
    string z = ""
    if not na(d)
        z := not na(ed) and ed > 0.886 and d < 1.1 ? "INVALID" : d >= 1.1 ? "F11" : d > 0.886 ? "BEYOND_0886" : d >= 0.788 ? "F0788" : d >= 0.705 ? "F0705" : d >= 0.62 ? "F062" : d >= 0.5 ? "F05" : "F0_05"
    z

// value area (VAH/VAL) of a price-row -> volume profile map
f_vaMap(map<float, float> prof) =>
    float row = rowTicks * syminfo.mintick
    float vah = na
    float val = na
    array<float> keys = map.keys(prof)
    int nk = array.size(keys)
    if nk > 0
        array.sort(keys, order.ascending)
        float total = 0.0
        int pi = 0
        float pv = -1.0
        for i = 0 to nk - 1
            float kv = map.get(prof, array.get(keys, i))
            total += kv
            if kv > pv
                pv := kv
                pi := i
        float acc = pv
        int lo = pi
        int hi = pi
        while acc < total * vaPct / 100 and (lo > 0 or hi < nk - 1)
            float below = lo > 0 ? map.get(prof, array.get(keys, lo - 1)) : -1.0
            float above = hi < nk - 1 ? map.get(prof, array.get(keys, hi + 1)) : -1.0
            if above >= below
                hi += 1
                acc += above
            else
                lo -= 1
                acc += below
        vah := array.get(keys, hi) + row
        val := array.get(keys, lo)
    [vah, val]

// fixed-range volume profile from the swing start to now (computed only when an alert is sent)
f_va(float t0) =>
    float row = rowTicks * syminfo.mintick
    map<float, float> prof = map.new<float, float>()
    for i = 0 to maxBack
        if time[i] < t0
            break
        float b = math.floor(hlc3[i] / row) * row
        map.put(prof, b, (map.contains(prof, b) ? map.get(prof, b) : 0.0) + volume[i])
    f_vaMap(prof)

// ---------- D108 Casper CONDITION: prior RTH (09:30-16:00 ET) value area vs today's RTH open ----------
bool inRth = not na(time(timeframe.period, "0930-1600", "America/New_York"))
var map<float, float> rthProf = map.new<float, float>()
var float pVah = na
var float pVal = na
var float rthOpen = na
if inRth and not inRth[1]
    rthOpen := open
if inRth
    float rb = math.floor(hlc3 / (rowTicks * syminfo.mintick)) * (rowTicks * syminfo.mintick)
    map.put(rthProf, rb, (map.contains(rthProf, rb) ? map.get(rthProf, rb) : 0.0) + volume)
var float pPoc = na
var float pHi = na
var float pLo = na
var float rHi = na
var float rLo = na
var array<float> lvns = array.new<float>()
if inRth and not inRth[1]
    rHi := high
    rLo := low
else if inRth
    rHi := math.max(rHi, high)
    rLo := math.min(rLo, low)
if not inRth and inRth[1] and map.size(rthProf) > 0
    [h1, l1] = f_vaMap(rthProf)
    pVah := h1
    pVal := l1
    // D110 AMT+: prior RTH POC, high / low and LVN rows (single-print-like low-volume rows inside the session range)
    array<float> ks = map.keys(rthProf)
    float rpv = -1.0
    for k in ks
        float kv = map.get(rthProf, k)
        if kv > rpv
            rpv := kv
            pPoc := k + rowTicks * syminfo.mintick / 2
    array.clear(lvns)
    for k in ks
        if map.get(rthProf, k) <= rpv * lvnPct / 100 and array.size(lvns) < 40
            array.push(lvns, k + rowTicks * syminfo.mintick / 2)
    pHi := rHi
    pLo := rLo
    map.clear(rthProf)
if not inRth and inRth[1]
    rthOpen := na   // outside RTH there is no 'today's open' until 09:30
string openVsValue = na(pVah) or na(rthOpen) ? "" : rthOpen > pVah ? "ABOVE_VAH" : rthOpen < pVal ? "BELOW_VAL" : "IN_VALUE"
float vaWidthAtr = na(pVah) or na(atrD) or atrD <= 0 ? na : (pVah - pVal) / atrD
float cvdSlope = math.sum(delta, cvdBars)
float closePos = high > low ? (close - low) / (high - low) : 0.5

// ---------- D110 AMT+ (AMT_PLUS_RULES.md): CONTEXT -> LOCATION -> order flow LAST ----------
// ETH VWAP anchored at the 18:00 ET Globex open; context = acceptance vs the PRIOR RTH value area during the first accN
// bars of each session (Asia 18:00, London 03:00, RTH 09:30); it holds until the next session's read.
float ethVwap = ta.vwap(hlc3, timeframe.change("D"))
bool inLondon = not na(time(timeframe.period, "0300-0930", "America/New_York"))
bool inAsiaS = not na(time(timeframe.period, "1800-0300", "America/New_York"))
string sessNow = inRth ? "RTH" : inLondon ? "LONDON" : inAsiaS ? "ASIA" : ""
var int accBars = 0
var int accAbove = 0
var int accBelow = 0
var string ctx = ""
var string ctxSess = ""
if sessNow != "" and sessNow != sessNow[1]
    accBars := 0
    accAbove := 0
    accBelow := 0
if sessNow != "" and not na(pVah) and accBars < accN
    accBars += 1
    accAbove += close > pVah ? 1 : 0
    accBelow += close < pVal ? 1 : 0
    if accBars == accN
        ctx := accAbove >= accN * accPct / 100 ? "ACCEPT_ABOVE" : accBelow >= accN * accPct / 100 ? "ACCEPT_BELOW" : "BALANCE"
        ctxSess := sessNow

// ---------- 3 PATH (Asia range + daily ATR(20) zones) ----------
bool inAsia = not na(time(timeframe.period, "1800-0300", "America/New_York"))
var float asH = na
var float asL = na
var float lockH = na
var float lockL = na
if inAsia and not inAsia[1]
    asH := high
    asL := low
    lockH := na
    lockL := na
else if inAsia
    asH := math.max(asH, high)
    asL := math.min(asL, low)
if not inAsia and inAsia[1]
    lockH := asH
    lockL := asL
string pathZone = ""
string pathSide = ""
if not na(lockH) and not na(atrD) and atrD > 0
    pathSide := close > lockH ? "ABOVE" : close < lockL ? "BELOW" : "INSIDE"
    pathZone := "INSIDE"
    float k = pathSide == "ABOVE" ? (close - lockH) / atrD : pathSide == "BELOW" ? (lockL - close) / atrD : 0.0
    array<float> zz = pathSide == "ABOVE" ? zUp : zDn
    if pathSide != "INSIDE"
        for i = 0 to 4
            if k >= array.get(zz, i)
                pathZone := array.get(zNames, i)

// ---------- 4 CONFIRMATION candle, then the pullback ENTRY candle ----------
float liqHi = ta.highest(high, liqLen)[1]
float liqLo = ta.lowest(low, liqLen)[1]
float avgAbsD = ta.sma(math.abs(delta), avgLen)
var array<float> outliers = array.new<float>()
if timeframe.change("D")
    array.clear(outliers)
if barstate.isconfirmed and not na(avgAbsD) and math.abs(delta) >= outK * avgAbsD and array.size(outliers) < 20
    array.push(outliers, hlc3)
float lvlTol = lvlTicks * syminfo.mintick
f_near(float lvl) => not na(lvl) and low - lvlTol <= lvl and high + lvlTol >= lvl
f_keyLevel() =>
    string t = ""
    if f_near(ethVwap)
        t := "ETH_VWAP"
    else if f_near(pVah)
        t := "PRIOR_VAH"
    else if f_near(pVal)
        t := "PRIOR_VAL"
    else if f_near(pPoc)
        t := "PRIOR_POC"
    else if f_near(pHi)
        t := "PRIOR_HIGH"
    else if f_near(pLo)
        t := "PRIOR_LOW"
    if t == ""
        for x in lvns
            if f_near(x)
                t := "LVN"
                break
    if t == ""
        for x in outliers
            if f_near(x)
                t := "DELTA_OUTLIER"
                break
    t
// nearest key level at least 1 tick beyond the entry on the trade side (the app checks it gives 1.5-3R)
f_target(int d, float px) =>
    float best = na
    for lv in array.from(ethVwap, pVah, pVal, pPoc, pHi, pLo)
        if not na(lv) and (lv - px) * d >= syminfo.mintick and (na(best) or math.abs(lv - px) < math.abs(best - px))
            best := lv
    best
float avgVol = ta.sma(volume, avgLen)
bool heavyD = not na(avgAbsD) and math.abs(delta) >= absK * avgAbsD
bool quiet = not na(avgVol) and volume <= exhK * avgVol
bool atLo = not na(liqLo) and low <= liqLo
bool atHi = not na(liqHi) and high >= liqHi

string cKindNow = ""
int cDirNow = 0
if barstate.isconfirmed
    if atLo and heavyD and delta < 0 and close >= hl2
        cKindNow := "ABSORPTION"
        cDirNow := 1
    else if atHi and heavyD and delta > 0 and close <= hl2
        cKindNow := "ABSORPTION"
        cDirNow := -1
    else if atLo and delta[1] < 0 and delta > absK * nz(avgAbsD) and close > high[1]
        cKindNow := "DELTA_DIVERGENCE"   // delta flip after failed selling initiative
        cDirNow := 1
    else if atHi and delta[1] > 0 and -delta > absK * nz(avgAbsD) and close < low[1]
        cKindNow := "DELTA_DIVERGENCE"
        cDirNow := -1
    else if atLo and quiet and close > open
        cKindNow := "DELTA_DIVERGENCE"   // exhaustion: participation dried up at the new low
        cDirNow := 1
    else if atHi and quiet and close < open
        cKindNow := "DELTA_DIVERGENCE"
        cDirNow := -1
    else if atLo and stackBuy >= stackN and close > open
        cKindNow := "STACKED_IMBALANCE"
        cDirNow := 1
    else if atHi and stackSell >= stackN and close < open
        cKindNow := "STACKED_IMBALANCE"
        cDirNow := -1

var int cDir = 0
var int cBar = na
var int cTime = na
var float cHi = na
var float cLo = na
var float aLo = na
var float aHi = na
var string cKind = ""

string kind = ""
int sig = 0
float defended = na
int confirmT = na
float absLow = na
float absHigh = na
if barstate.isconfirmed and cDir != 0
    int age = bar_index - cBar
    bool broken = cDir == 1 ? close < aLo : close > aHi
    if age > waitBars or broken
        cDir := 0
    else if age >= 1 and (cDir == 1 ? low <= cHi : high >= cLo)   // entry candle pulled back into the confirmation candle
        sig := cDir
        kind := cKind
        confirmT := cTime
        absLow := aLo
        absHigh := aHi
        defended := cDir == 1 ? aLo : aHi
        cDir := 0
if cDirNow != 0 and sig == 0
    cDir := cDirNow
    cBar := bar_index
    cTime := time_close
    cHi := high
    cLo := low
    aLo := cDirNow == 1 ? low : absBotS
    aHi := cDirNow == 1 ? absTopL : high
    cKind := cKindNow

// ---------- plan + webhook alert ----------
f_px(float x) => na(x) ? "null" : str.tostring(x, format.mintick)
f_q(string s) => s == "" ? "null" : '"' + s + '"'

float entry = close
float stop = na
float target = na
if sig != 0
    float raw = defended - sig * bufTicks * syminfo.mintick
    stop := sig == 1 ? math.floor(raw / syminfo.mintick) * syminfo.mintick : math.ceil(raw / syminfo.mintick) * syminfo.mintick
    float risk = math.abs(entry - stop)
    if risk <= 0 or (entry - stop) * sig <= 0
        sig := 0
    else
        float rawT = entry + sig * 2 * risk
        target := sig == 1 ? math.floor(rawT / syminfo.mintick) * syminfo.mintick : math.ceil(rawT / syminfo.mintick) * syminfo.mintick

if sig != 0
    string dir = sig == 1 ? "LONG" : "SHORT"
    // location is measured on the side of the trade; a trade against the swing's impulse has no fib location
    bool sameSide = bias == sig
    float fib = sameSide ? depth : na
    string locZone = sameSide ? f_zone(depth, extDepth) : ""
    if locZone == "INVALID"
        fib := 2.0   // reversal idea invalidated (a close beyond 0.886): outside every allowed zone
    [vah, val] = f_va(math.min(swHt, swLt))
    string vSide = na(vah) ? "" : close > vah ? "ABOVE_VAH" : close < val ? "BELOW_VAL" : "IN_VALUE"
    string keyLvl = f_keyLevel()
    alert('{"v":1,"secret":"' + secret + '","id":"' + syminfo.ticker + "-TIGHT-" + str.tostring(time_close) +
          "-ORDER_FLOW-" + dir + '","symbol":"' + syminfo.ticker + '","profile":"TIGHT","tf":"' + timeframe.period +
          '","bar_time_ms":' + str.tostring(time_close) + ',"event":"ORDER_FLOW","direction":"' + dir +
          '","order_flow":{"kind":"' + kind + '","entry":' + f_px(entry) + ',"defended":' + f_px(defended) +
          ',"stop":' + f_px(stop) + ',"target":' + f_px(target) + ',"delta":' + str.tostring(delta, "#.##") +
          ',"env":' + f_q(env) + ',"location_zone":' + f_q(locZone) + ',"fib":' + (na(fib) ? "null" : str.tostring(fib, "#.###")) +
          ',"value_side":' + f_q(vSide) + ',"path_zone":' + f_q(pathZone) + ',"path_side":' + f_q(pathSide) +
          ',"delta_source":"' + dSrc + '","confirm_time":' + str.tostring(confirmT) +
          ',"absorption_low":' + f_px(absLow) + ',"absorption_high":' + f_px(absHigh) +
          ',"stacked":' + str.tostring(sig == 1 ? stackBuy : stackSell) +
          ',"close_pos":' + str.tostring(closePos, "#.###") + ',"cvd_slope":' + str.tostring(cvdSlope, "#.##") +
          ',"open_vs_value":' + f_q(openVsValue) +
          ',"prior_va_width_atr":' + (na(vaWidthAtr) ? "null" : str.tostring(vaWidthAtr, "#.###")) +
          ',"prev_rth_vah":' + f_px(pVah) + ',"prev_rth_val":' + f_px(pVal) + ',"prev_rth_poc":' + f_px(pPoc) +
          ',"eth_vwap":' + f_px(ethVwap) + ',"context":' + f_q(ctx) + ',"ctx_session":' + f_q(ctxSess) +
          ',"key_level_type":' + f_q(keyLvl) + ',"target_level":' + f_px(f_target(sig, entry)) + "}}",
          alert.freq_once_per_bar_close)

// ---------- D111 ATR-zone type: event zone (iceberg PROXY = footprint absorption / large volume, NO MBO data) ----------
// ATR = Wilder ATR(14) of the last CLOSED 5-minute bar. POSITION alert once per zone at 115% ATR outside it; REVERSION
// alert at 1/2/3 ATR away (the app checks every rule; k=1 rarely passes its 1.5R floor). EVENT alerts move the trail.
float zAtr5 = request.security(syminfo.tickerid, "5", ta.atr(14)[1], lookahead = barmerge.lookahead_on)
float sum5 = math.sum(volume, 5)
float sum5Avg = ta.sma(sum5, 1950)
float rvol = sum5Avg > 0 ? sum5 / sum5Avg : na   // proxy: vs ~5 sessions of 5-bar volume
float range5 = ta.highest(high, 5) - ta.lowest(low, 5)
float tickV = useTick ? request.security(tickSym, "1", close) : na
float rowV = rowTicks * syminfo.mintick
float evSize = real ? volume / math.max(1, math.round((high - low) / rowV)) * 2 : volume / math.max(1, math.round((high - low) / rowV))
bool zEvent = barstate.isconfirmed and not na(avgVol) and (volume >= evVolK * avgVol or heavyD)
var float zHi = na
var float zLo = na
var int zT = na
var float zSize = na
var string zKind = ""
var float pzHi = na
var float pzLo = na
var bool zPosDone = false
var int zRevUp = 0
var int zRevDn = 0
string zSig = ""
int zDir = 0
int zK = na
if zoneOn and zEvent
    pzHi := zHi
    pzLo := zLo
    zHi := high
    zLo := low
    zT := time_close
    zSize := evSize
    zKind := heavyD ? "ABSORPTION" : "LARGE_VOLUME"
    zPosDone := false
    zRevUp := 0
    zRevDn := 0
    zSig := "EVENT"
    zDir := close >= hl2 ? 1 : -1
else if zoneOn and barstate.isconfirmed and not na(zHi) and not na(zAtr5) and zAtr5 > 0
    if not zPosDone and close >= zHi + 1.15 * zAtr5
        zSig := "POSITION"
        zDir := 1
        zPosDone := true
    else if not zPosDone and close <= zLo - 1.15 * zAtr5
        zSig := "POSITION"
        zDir := -1
        zPosDone := true
    else
        int kDn = int(math.floor((zLo - close) / zAtr5))
        int kUp = int(math.floor((close - zHi) / zAtr5))
        if kDn >= 1 and kDn <= 3 and kDn > zRevDn
            zSig := "REVERSION"
            zDir := 1
            zK := kDn
            zRevDn := kDn
        else if kUp >= 1 and kUp <= 3 and kUp > zRevUp
            zSig := "REVERSION"
            zDir := -1
            zK := kUp
            zRevUp := kUp
if zSig != ""
    string zd = zDir == 1 ? "LONG" : "SHORT"
    alert('{"v":1,"secret":"' + secret + '","id":"' + syminfo.ticker + "-TIGHT-" + str.tostring(time_close) +
          "-ZONE_" + zSig + "-" + zd + '","symbol":"' + syminfo.ticker + '","profile":"TIGHT","tf":"' + timeframe.period +
          '","bar_time_ms":' + str.tostring(time_close) + ',"event":"ORDER_FLOW","direction":"' + zd +
          '","order_flow":{"kind":"ZONE","entry":' + f_px(close) + ',"defended":' + f_px(zDir == 1 ? zLo : zHi) +
          ',"delta_source":"' + dSrc + '","zone_signal":"' + zSig + '","event_zone_hi":' + f_px(zHi) +
          ',"event_zone_lo":' + f_px(zLo) + ',"event_kind":' + f_q(zKind) + ',"event_time":' + str.tostring(zT) +
          ',"event_size":' + str.tostring(zSize, "#") + ',"atr5":' + f_px(zAtr5) +
          ',"rev_level":' + (na(zK) ? "null" : str.tostring(zK)) + ',"prior_event_hi":' + f_px(pzHi) +
          ',"prior_event_lo":' + f_px(pzLo) + ',"rvol":' + (na(rvol) ? "null" : str.tostring(rvol, "#.##")) +
          ',"range5_atr":' + (na(zAtr5) or zAtr5 <= 0 ? "null" : str.tostring(range5 / zAtr5, "#.##")) +
          ',"tick":' + (na(tickV) ? "null" : str.tostring(math.round(tickV))) +
          ',"context":' + f_q(ctx) + ',"key_level_type":' + f_q(f_keyLevel()) + ',"target_level":' + f_px(f_target(zDir, close)) + "}}",
          alert.freq_once_per_bar_close)

plotshape(showMarks and sig == 1, "Order flow LONG", shape.triangleup, location.belowbar, color.new(#3B82F6, 0), size = size.tiny)
plotshape(showMarks and sig == -1, "Order flow SHORT", shape.triangledown, location.abovebar, color.new(#D4AF37, 0), size = size.tiny)
plot(lockH, "Asia high", color.new(#D4AF37, 30), style = plot.style_linebr)
plot(lockL, "Asia low", color.new(#D4AF37, 30), style = plot.style_linebr)
plot(bias == 1 ? swH - 0.705 * rng : bias == -1 ? swL + 0.705 * rng : na, "Fib 0.705", color.new(#93C5FD, 40), style = plot.style_linebr)
plot(bias == 1 ? swH - 0.886 * rng : bias == -1 ? swL + 0.886 * rng : na, "Fib 0.886", color.new(#93C5FD, 20), style = plot.style_linebr)
