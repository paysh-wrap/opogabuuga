//@version=6
// Paytience_Bridge — sends closed-bar events to the Paytience app via ONE webhook alert per chart.
// Mirrors backend/app/indicators/ exactly (Python reference) — both are ports of the ORIGINAL sources:
//  • "ICT Fractal Model, HTF Candles, CISD & C2 Targets [LunqFX]" (open-source, © LunqFX) — fractal state machine
//    (D105: LunqFX was removed from Paytience; its alerts are ignored by the app. Only HEARTBEAT bars matter now.)
// D120: the BigBeluga Market Structure Oscillator was removed (no MSO events, no mso field in the heartbeat).
// This bridge is shared under CC BY-NC-SA 4.0. PERSONAL USE ONLY.
//
// Setup: MNQ1! chart, 1-minute for profile TIGHT or 5-minute for STD. Add this indicator, paste the webhook secret,
// create an alert: Condition "Paytience_Bridge" → "Any alert() function call", Webhook URL = your Paytience URL.
indicator("Paytience_Bridge", overlay = true, max_labels_count = 200)

secret    = input.string("", "Webhook secret")
profile   = input.string("STD", "Profile", options = ["TIGHT", "STD"])
atrLen    = input.int(14, "HTF ATR length", minval = 1)
showMarks = input.bool(true, "Show markers")

htfMin      = profile == "TIGHT" ? 15 : 60
htfStr      = profile == "TIGHT" ? "15" : "60"
ltfExpected = profile == "TIGHT" ? "1" : "5"
if timeframe.period != ltfExpected
    runtime.error("Paytience_Bridge: profile " + profile + " needs a " + ltfExpected + "-minute chart")

htfMs = htfMin * 60000
newH  = timeframe.change(htfStr)

// ---------- formatting helpers (pure) ----------
f_px(float x) => na(x) ? "null" : str.tostring(x, format.mintick)
f_raw(float x) => na(x) ? "null" : str.tostring(x)
f_b(bool b) => b ? "true" : "false"
f_i(int x) => na(x) ? "null" : str.tostring(x)

f_send(string evt, string dir, string extra) =>
    string tail = extra == "" ? "" : "," + extra
    alert('{"v":1,"secret":"' + secret + '","id":"' + syminfo.ticker + "-" + profile + "-" +
          str.tostring(time_close) + "-" + evt + "-" + dir + '","symbol":"' + syminfo.ticker + '","profile":"' +
          profile + '","tf":"' + timeframe.period + '","bar_time_ms":' + str.tostring(time_close) +
          ',"event":"' + evt + '","direction":"' + dir + '"' + tail + "}", alert.freq_once_per_bar_close)

f_fr(float c1h, float c1l, int c1t, float atr, float t1, float t2, float inv, float swx, int swt, float cisd, bool cb, bool pre, int c3) =>
    '"fractal":{"c1_high":' + f_px(c1h) + ',"c1_low":' + f_px(c1l) + ',"c1_time_ms":' + f_i(c1t) +
     ',"htf_atr14":' + (na(atr) ? "null" : str.tostring(atr, "#.####")) + ',"t1":' + f_raw(t1) + ',"t2":' + f_px(t2) +
     ',"invalid":' + f_px(inv) + ',"sweep_extreme":' + f_px(swx) + ',"sweep_time_ms":' + f_i(swt) +
     ',"cisd_level":' + f_px(cisd) + ',"cisd_before_c2_close":' + f_b(cb) + ',"t1_preticked":' + f_b(pre) +
     ',"c3_close_time_ms":' + f_i(c3) + "}"

// ---------- state ----------
var int   hS = na
var float hO = na
var float hH = na
var float hL = na
var float lastH = na   // last finished HTF candle (C1 candidate)
var float lastL = na
var float lastC = na
var int   lastS = na
var bool  haveFinished = false
var float prevFinC = na
var float atrV = na
var int   atrN = 0
var float atrSum = 0.0
var array<float> hHs = array.new_float()
var array<float> hLs = array.new_float()
var string hTrend = "NONE"
var float hPh = na
var float hPl = na
var float prevHtfStructC = na
var float dnRun = na
var float upRun = na
var int   barN = 0
var int   stage = 0
var int   dirM = 0
var float c1H = na
var float c1L = na
var int   c1S = na
var float swX = na
var int   swT = na
var float cisdLvl = na
var bool  cisdOn = false
var bool  cisdEarly = false
var float t1 = na
var float t2 = na
var float inv = na
var int   liveN = na
var int   hitMax = 0
var bool  pre = false
var int   c3Close = na
var float atrLive = na

bool mkSweepL = false
bool mkSweepS = false
bool mkConfL = false
bool mkConfS = false

    // ---------- HTF candle (closed on the first bar of the next period, like the original) ----------
    bool htfClosed = false
    if newH and not na(hO)
        lastH := hH
        lastL := hL
        lastC := close[1]
        lastS := hS
        haveFinished := true
        htfClosed := true
        tr = na(prevFinC) ? hH - hL : math.max(hH - hL, math.abs(hH - prevFinC), math.abs(hL - prevFinC))
        prevFinC := lastC
        if na(atrV)
            atrSum += tr
            atrN += 1
            if atrN == atrLen
                atrV := atrSum / atrLen
        else
            atrV := (atrV * (atrLen - 1) + tr) / atrLen
        // HTF structure (pivots + crossover on finished HTF candles) → htf_trend
        array.push(hHs, hH)
        array.push(hLs, hL)
        if array.size(hHs) > pivL + pivR + 1
            array.shift(hHs)
            array.shift(hLs)
        if array.size(hHs) == pivL + pivR + 1
            cH = array.get(hHs, pivL)
            cL = array.get(hLs, pivL)
            isPh = true
            isPl = true
            for i = 0 to pivL + pivR
                if i < pivL
                    isPh := isPh and cH > array.get(hHs, i)
                    isPl := isPl and cL < array.get(hLs, i)
                else if i > pivL
                    isPh := isPh and cH >= array.get(hHs, i)
                    isPl := isPl and cL <= array.get(hLs, i)
            if isPh
                hPh := cH
            if isPl
                hPl := cL
        if not na(hPh) and not na(prevHtfStructC) and lastC > hPh and prevHtfStructC <= hPh
            hTrend := "BULL"
            hPh := na
        if not na(hPl) and not na(prevHtfStructC) and lastC < hPl and prevHtfStructC >= hPl
            hTrend := "BEAR"
            hPl := na
        prevHtfStructC := lastC
    if newH or na(hO)
        hS := int(math.floor(time / htfMs) * htfMs)
        hO := open
        hH := high
        hL := low
    else
        hH := math.max(hH, high)
        hL := math.min(hL, low)
    // runs of same-colour candles (CISD reference)
    if close < open and not (close[1] < open[1])
        dnRun := open
    if close > open and not (close[1] > open[1])
        upRun := open
    barN += 1
    isLong = dirM == 1
    string dS = isLong ? "LONG" : "SHORT"

    // ---------- CISD ----------
    if stage >= 1 and not cisdOn and not na(cisdLvl) and (isLong ? close > cisdLvl : close < cisdLvl)
        cisdOn := true
        f_send("CISD", dS, stage == 2 ? f_fr(c1H, c1L, c1S, atrLive, t1, t2, inv, swX, swT, cisdLvl, cisdEarly, pre, c3Close) : f_fr(c1H, c1L, c1S, atrV, (c1H + c1L) / 2, isLong ? c1H : c1L, swX, swX, swT, cisdLvl, true, false, na))

    // ---------- stage 2: C3 running ----------
    if stage == 2
        failNow = isLong ? low < inv : high > inv
        if not failNow
            for k = 1 to 2
                tk = k == 1 ? t1 : t2
                if hitMax == k - 1 and (isLong ? high >= tk : low <= tk)
                    hitMax := k
                    f_send(k == 1 ? "T1_HIT" : "T2_HIT", dS, f_fr(c1H, c1L, c1S, atrLive, t1, t2, inv, swX, swT, cisdLvl, cisdEarly, pre, c3Close))
        expired = htfClosed and barN > liveN
        if failNow or hitMax == 2 or expired
            if failNow
                f_send("MODEL_FAILED", dS, f_fr(c1H, c1L, c1S, atrLive, t1, t2, inv, swX, swT, cisdLvl, cisdEarly, pre, c3Close))
            else if hitMax != 2
                f_send("C3_CLOSED", dS, f_fr(c1H, c1L, c1S, atrLive, t1, t2, inv, swX, swT, cisdLvl, cisdEarly, pre, c3Close))
            stage := 0
            dirM := 0

    // ---------- stage 1: C2 has swept C1 ----------
    if stage == 1
        if htfClosed
            both = lastH > c1H and lastL < c1L
            inside = lastC > c1L and lastC < c1H
            if not both and inside
                stage := 2
                cisdEarly := cisdOn
                liveN := barN
                hitMax := 0
                t1 := (c1H + c1L) / 2
                t2 := isLong ? c1H : c1L
                inv := swX
                pre := isLong ? lastC >= t1 : lastC <= t1
                if pre
                    hitMax := 1
                c3Close := hS + htfMs
                atrLive := atrV
                if isLong
                    mkConfL := true
                else
                    mkConfS := true
                f_send("MODEL_CONFIRMED", dS, f_fr(c1H, c1L, c1S, atrLive, t1, t2, inv, swX, swT, cisdLvl, cisdEarly, pre, c3Close))
            else
                stage := 0
                dirM := 0
        else if isLong ? low < swX : high > swX
            swX := isLong ? low : high
            swT := time_close
            cisdLvl := isLong ? dnRun : upRun

    // ---------- stage 0: the forming HTF candle (C2) takes the last finished one (C1) ----------
    if stage == 0 and haveFinished and not htfClosed
        upSw = hH > lastH
        dnSw = hL < lastL
        if upSw != dnSw
            stage := 1
            dirM := dnSw ? 1 : -1
            c1H := lastH
            c1L := lastL
            c1S := lastS
            swX := dnSw ? hL : hH
            swT := time_close
            cisdOn := false
            cisdEarly := false
            cisdLvl := dnSw ? dnRun : upRun
            if dnSw
                mkSweepL := true
            else
                mkSweepS := true
            f_send("C1_SWEPT", dnSw ? "LONG" : "SHORT", f_fr(c1H, c1L, c1S, atrV, (c1H + c1L) / 2, dnSw ? c1H : c1L, swX, swX, swT, cisdLvl, false, false, na))

    // ---------- heartbeat (D120: no mso field) ----------
    // D112: real-time check - on a live bar, timenow - time_close is the delay of the data feed (CME real-time = ~0).
    string dataFeed = barstate.isrealtime ? ((timenow - time_close) <= 90000 ? "realtime" : "delayed") : "unknown"
    f_send("HEARTBEAT", "NONE", '"data_feed":"' + dataFeed + '","price":{"o":' + f_px(open) + ',"h":' + f_px(high) + ',"l":' + f_px(low) +
                                ',"c":' + f_px(close) + ',"v":' + str.tostring(volume) + '}')

plotshape(showMarks and mkSweepL, "C1 low swept", shape.triangleup, location.belowbar, color.new(#3B82F6, 0), size = size.tiny)
plotshape(showMarks and mkSweepS, "C1 high swept", shape.triangledown, location.abovebar, color.new(#3B82F6, 0), size = size.tiny)
plotshape(showMarks and mkConfL, "Model LONG", shape.labelup, location.belowbar, color.new(#D4AF37, 0), text = "L", textcolor = #0A1020)
plotshape(showMarks and mkConfS, "Model SHORT", shape.labeldown, location.abovebar, color.new(#D4AF37, 0), text = "S", textcolor = #0A1020)
plot(stage == 2 ? t1 : na, "T1", color.new(#93C5FD, 0), style = plot.style_linebr)
plot(stage == 2 ? t2 : na, "T2", color.new(#D4AF37, 0), style = plot.style_linebr)
plot(stage == 2 ? inv : na, "Invalid", color.new(#F2D27A, 40), style = plot.style_linebr)
