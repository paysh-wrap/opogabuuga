+class BigDogRow(_M):
+    """One plan row of the Big Dog table (D87). Values are the formula results in app/risk/big_dog.py; a row may only be
+    TIGHTER than the formula (validated in BigDogCfg), never looser."""
+
+    plan: str
+    account_size: D
+    mll: D  # the plan's max loss limit (drawdown distance)
+    per_trade_usd: D
+    day_loss_usd: D
+    micros: int
+
+
+# D87 per-plan table. Formula (risk/big_dog.formula), reference Pro 25K (MLL $1,000, 3 micros):
+#   per_trade_usd = 12.5% x MLL | day_loss_usd = 37.5% x MLL | micros = floor(3 x MLL / 1000), capped by plan max micros
+_BIG_DOG_ROWS = [
+    BigDogRow(plan=p, account_size=D(sz), mll=D(m), per_trade_usd=D(pt), day_loss_usd=D(dl), micros=mc)
+    for p, sz, m, pt, dl, mc in [
+        ("lucid_pro_25k", 25000, 1000, "125.00", "375.00", 3),
+        ("lucid_flex_25k", 25000, 1000, "125.00", "375.00", 3),
+        ("lucid_daily_25k", 25000, 1000, "125.00", "375.00", 3),
+        ("lucid_pro_50k", 50000, 2000, "250.00", "750.00", 6),
+        ("lucid_flex_50k", 50000, 2000, "250.00", "750.00", 6),
+        ("lucid_pro_100k", 100000, 3000, "375.00", "1125.00", 9),
+        ("lucid_flex_100k", 100000, 3000, "375.00", "1125.00", 9),
+        ("lucid_pro_150k", 150000, 4500, "562.50", "1687.50", 13),
+        ("lucid_flex_150k", 150000, 4500, "562.50", "1687.50", 13),
+    ]
+]
+
+
+class BigDogCfg(_M):
+    """D87 (user 2026-11-10): "Big Dog Small Trade Aggressive", an AI Duo sub-mode (PAPER only through AI Duo's
+    guard, default OFF). Same markets / window / entry / SL / TP / BE / trail / lock as AI Duo; adds a small per-trade
+    risk with up to `micros` micros, a day loss cap, max trades, a stop after max_losses losses and a day profit stop
+    (profit_stop_pct of the plan's profit target, read from the plan file). Re-entry on later VWAP pullbacks on the
+    same AI side, one position per market."""
+
+    enabled: bool = False
+    ref_mll: D = D("1000")  # Pro 25K reference
+    ref_micros: int = 3
+    per_trade_pct: D = D("12.5")
+    day_loss_pct: D = D("37.5")
+    max_trades: int = 5
+    max_losses: int = 3
+    profit_stop_pct: D = D("39")
+    table: list[BigDogRow] = _BIG_DOG_ROWS
+
+    @model_validator(mode="after")
+    def _valid(self) -> BigDogCfg:
+        if self.ref_mll <= 0 or self.ref_micros < 1 or self.max_trades < 1 or self.max_losses < 1:
+            raise ValueError("big_dog: ref_mll > 0, ref_micros, max_trades, max_losses >= 1")
+        if not (D(0) < self.per_trade_pct <= self.day_loss_pct <= D(100)) or not (
+            D(0) < self.profit_stop_pct <= D(100)
+        ):
+            raise ValueError("big_dog: 0 < per_trade_pct <= day_loss_pct <= 100 and 0 < profit_stop_pct <= 100")
+        from app.risk.big_dog import formula  # pure helper, no config import
+
+        for row in self.table:
+            per, day, mc = formula(row.mll, self.per_trade_pct, self.day_loss_pct, self.ref_mll, self.ref_micros, 10**6)
+            if (
+                row.per_trade_usd > per
+                or row.day_loss_usd > day
+                or row.micros > mc
+                or min(row.per_trade_usd, row.day_loss_usd) <= 0
+                or row.micros < 1
+            ):
+                raise ValueError(f"big_dog: table row {row.plan} may only be tighter than the formula")
+        return self
+
+    def row_for(self, account_size: D) -> BigDogRow | None:
+        """The row for an account of this size (Pro / Flex / Daily of one size share their numbers)."""
+        return next((x for x in self.table if x.account_size == account_size), None)
+
