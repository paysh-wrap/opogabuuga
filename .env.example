# Copy to .env and fill in. Never commit .env.  Generate keys with: make keys
PAYTIENCE_MASTER_KEY=
PAYTIENCE_WEBHOOK_SECRET=
# PAPER by default. LIVE also needs the Settings toggle, typed phrase and Live-Readiness Checklist (§1.5).
PAYTIENCE_ALLOW_LIVE=false
# Set true when served over HTTPS (Cloudflare Tunnel)
PAYTIENCE_COOKIE_SECURE=false
