<?xml version="1.0" encoding="utf-8"?>
<!-- Paytience runs on the user's own computer on the LAN (plain http). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
